# ──────────────────────────────────────────────────────────────────────────────
# Backend (NestJS) орчны хувьсагч — apps/backend/.env болгож хуулаад бөглөнө.
#
# ⚠️ Энэ файлд ЖИНХЭНЭ нууц утга бичихийг ХОРИГЛОНО — энэ нь git-д commit
#    хийгддэг загвар файл. Бодит утгууд зөвхөн .env дотор (git-д ордоггүй).
#
# Заавал байх ёстой хувьсагчийг ачаалах үед src/config/env.validation.ts
# шалгана — дутуу бол сервер огт эхлэхгүй.
# ──────────────────────────────────────────────────────────────────────────────

# ── Үндсэн ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Nest нь URL угтвар (global prefix) АШИГЛАДАГГҮЙ — маршрутууд нь /auth/*,
# /monitoring/* гэх мэт үндсэн замд байрлана. Reverse proxy-г үүнд тааруулна.

# ── Аюулгүй байдал ────────────────────────────────────────────────────────────
# Дор хаяж 32 тэмдэгт. Үүсгэх: openssl rand -base64 48
JWT_SECRET=

# Frontend-ийн origin-ууд, таслалаар тусгаарлана. Яг тааруулж бичнэ
# (subdomain хуурахаас сэргийлж ЯГ тэнцүү харьцуулдаг).
CORS_ORIGINS=http://localhost:9002

# production дээр ЗААВАЛ. HTTPS-ээр үйлчилж байвал "true".
COOKIE_SECURE=false

# Reverse proxy-ийн X-Forwarded-For-т хэдэн hop-д итгэхийг заана.
#   1        → урд нь яг 1 proxy (nginx/ingress) байна (default)
#   loopback → зөвхөн Docker дотоод proxy
#   0        → proxy байхгүй; X-Forwarded-For-т огт итгэхгүй
# ⚠️ Бодит топологитойгоо тааруулна — буруу бол brute-force хамгаалалтын
#    IP-г халдагч хуурч болно.
TRUST_PROXY=1

# DB холболтын тохиргоог шифрлэх ТУСДАА түлхүүр (AES-256-GCM).
# Хоосон бол JWT_SECRET-ээс гаралтай түлхүүр рүү шилжинэ — production дээр
# тусад нь өгөхийг зөвлөнө (нэг нууц задрахад хоёулаа задрахаас сэргийлнэ).
# CREDENTIAL_ENCRYPTION_KEY нь хуучин нэр — хоёуланг нь дэмжинэ.
CONFIG_ENC_KEY=
# CREDENTIAL_ENCRYPTION_KEY=

# ── ClickHouse ────────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_DATABASE=audit_db
CLICKHOUSE_USER=audit_app
CLICKHOUSE_PASSWORD=

# Схем үүсгэх / хэрэглэгч бэлтгэх үеийн admin эрх. Зөвхөн эхлэх агшинд
# ашиглагдаад тэр даруй хаагдана. Хоосон бол CLICKHOUSE_USER, эсвэл "default".
CLICKHOUSE_BOOTSTRAP_USER=
CLICKHOUSE_BOOTSTRAP_PASSWORD=

# ── Oracle (alert-box / CIF хайлт) ────────────────────────────────────────────
# Хоосон бол Oracle-ийн боломжууд идэвхгүй болно.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1

# ── Python тайлангийн сервис ──────────────────────────────────────────────────
# production дээр URL болон KEY хоёулаа ЗААВАЛ (сервис рүү код илгээдэг).
# PYTHON_SERVICE_URL нь давуу эрхтэй; PYTHON_API_URL нь хуучин нэр.
PYTHON_SERVICE_URL=http://127.0.0.1:8001
# PYTHON_API_URL=http://127.0.0.1:8001
PYTHON_API_KEY=
