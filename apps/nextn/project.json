{
  "name": "nextn",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/nextn/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "outputs": [
        "{projectRoot}/.next",
        "{workspaceRoot}/apps/nextn/.next/!(cache)/**/*",
        "{workspaceRoot}/apps/nextn/.next/!(cache)"
      ],
      "configurations": {
        "development": {}
      }
    },
    "serve": {
      "defaultConfiguration": "development",
      "options": {
        "port": 9002
      },
      "configurations": {
        "development": {}
      }
    },
    "start": {
      "dependsOn": ["build"],
      "options": {
        "port": 9002
      }
    }
  }
}
